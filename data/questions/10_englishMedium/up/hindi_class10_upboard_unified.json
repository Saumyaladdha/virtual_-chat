  "exam_strategy": {
    "note": "",
    "tips": [
      "Khand-A (20 MCQ) OMR mein achchhe se bharein — yahan se 20 marks pakke ho sakte hain",
      "OMR par gola kaatna/whitener lagana FORBIDDEN hai — answer sochkar hi bharein",
      "Q1 aur Q2 mein sandarbh format sahi hona chahiye — Lekhak, Rachna, Prasang teen cheezein",
      "Q6 jeevan parichay mein 10 marks hain — ye section topper banta hai, isko seriously lein",
      "Q10 nibandh mein 7 marks hain — do topics pakke tayaar karein",
      "Q5 khandakavya mein sirf apna padha hua khandakavya choose karein",
      "Sanskrit anuvad (Q3+Q4) mein sandarbh likhna 2 marks = aasaan marks",
      "Patra lekhan (Q8) ka format bilkul sahi hona chahiye — format se 2 marks milte hain",
      "Q7 mein ek shlok kanthsth hai — pura likhein, adha nahi",
      "Handwriting sunder aur spasht rakhein — Q10 nibandh aur Q6 jeevan parichay mein presentation se marks milte hain",
      "Set number aur roll number cover page par likhna bilkul mat bhoolein"
    ],
    "time_allocation": [
      {
        "section_id": "reading_time",
        "recommended_minutes": 15,
        "note": "15 min — question paper padhein. Khand-B mein OR choices padhkar decide karein kaun sa choose karenge."
      },
      {
        "section_id": "Khand_A_MCQ",
        "recommended_minutes": 25,
        "note": "25 min — OMR mein dhyaan se bharein. Process of elimination use karein. Galat jawab mein marks nahi katenge."
      },
      {
        "section_id": "Q1_Q2_comprehension",
        "recommended_minutes": 20,
        "note": "20 min — sandarbh + rekhankit ansh ki vyaakhya + prashna. Format yaad rakhein."
      },
      {
        "section_id": "Q3_Q4_Sanskrit",
        "recommended_minutes": 20,
        "note": "20 min — Sanskrit anuvad dhyaan se karein. Sandarbh pehle likhein."
      },
      {
        "section_id": "Q5_Q6_Q7",
        "recommended_minutes": 25,
        "note": "25 min — Q5 khandakavya (10 min), Q6 jeevan parichay (12 min), Q7 shlok (3 min)."
