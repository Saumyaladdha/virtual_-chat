  "exam_strategy": {
    "note": "",
    "tips": [
      "Q1-Q5 mein 30 marks hain — MPBSE Maths ka objective section scoring hai. Basic formulas pakke yaad karo.",
      "4u²+8u ke zeroes EXACT same question 2023 aur 2025 mein aaya — answer = 0 and -2.",
      "Prove tangents from external point equal = Q19 mein har saal aata hai. Proof 5 steps mein pakka kar lo.",
      "Volume of cone = (1/3)πr²h, hemisphere = (2/3)πr³ — ye True/False mein galat diya jaata hai. Dhyan rakho.",
      "9sec²A - 9tan²A = 9 — match pairs mein GUARANTEED. Identity: sec²A-tan²A=1, so 9(1)=9.",
      "Statistics Q23 mein EITHER mode ya mean by assumed mean aata hai — dono ka formula yaad karo.",
      "Heights & Distances Q18/Q22 mein DIAGRAM pehle banao. tan(angle) = height/base use karo.",
      "Class mark 20-40 = 30 — Q5 mein GUARANTEED.",
      "P(E) + P(Ē) = 1 — fill blank mein GUARANTEED.",
      "Standard form ax²+bx+c=0 — MCQ mein GUARANTEED.",
      "OR options mein se pehle dono padhke aasaan wala choose karo.",
      "Working (steps) dikhana zaroori hai — sirf answer likha toh marks nahi milenge."
    ],
    "time_allocation": [
      {
        "section_id": "Q1_to_Q5_objective",
        "recommended_minutes": 30,
        "note": "30 min — sab formulas yaad hon toh 28-30 marks pakke."
      },
      {
        "section_id": "Q6_to_Q17_very_short",
        "recommended_minutes": 40,
        "note": "40 min — 3 min per question. Working dikhao. OR option mein easier wala choose karo."
      },
      {
        "section_id": "Q18_to_Q20_short",
        "recommended_minutes": 20,
        "note": "20 min — 6-7 min per question. Proof yaad karo (Q19)."
      },
      {
        "section_id": "Q21_to_Q23_long",
        "recommended_minutes": 30,
        "note": "30 min — 10 min each. Word problem step-by-step, diagram banao (Q22), table method (Q23)."
      },
      {
        "section_id": "revision",
        "recommended_minutes": 10,
        "note": "10 min — formulas check, set number, roll number verify"
      }
    ]
  },
