  "exam_strategy": {
    "note": "",
    "tips": [
      "Q1-Q5 में 30 मार्क्स हैं — एमपीबीएसई गणित का ऑब्जेक्टिव सेक्शन स्कोरिंग है। बेसिक फॉर्मूला पक्के याद करो।",
      "4u²+8u के शून्यक एग्ज़ैक्ट सेम क्वेश्चन 2023 और 2025 में आया — आंसर = 0 और -2।",
      "बाह्य बिंदु से स्पर्श रेखाएँ बराबर सिद्ध करें = Q19 में हर साल आता है। प्रूफ 5 स्टेप्स में पक्का कर लो।",
      "शंकु का आयतन = (1/3)πr²h, गोलार्ध = (2/3)πr³ — ये सत्य/असत्य में गलत दिया जाता है। ध्यान रखो।",
      "9sec²A - 9tan²A = 9 — मैच पेयर्स में गारंटीड। सर्वसमिका: sec²A-tan²A=1, तो 9(1)=9।",
      "सांख्यिकी Q23 में EITHER बहुलक या कल्पित माध्य से माध्य आता है — दोनों का फॉर्मूला याद करो।",
      "ऊँचाई एवं दूरी Q18/Q22 में डायग्राम पहले बनाओ। tan(कोण) = ऊँचाई/आधार उपयोग करो।",
      "20-40 का वर्ग चिह्न = 30 — Q5 में गारंटीड।",
      "P(E) + P(Ē) = 1 — फिल ब्लैंक में गारंटीड।",
      "मानक रूप ax²+bx+c=0 — MCQ में गारंटीड।",
      "OR ऑप्शन्स में से पहले दोनों पढ़के आसान वाला चूज़ करो।",
      "वर्किंग (स्टेप्स) दिखाना ज़रूरी है — सिर्फ आंसर लिखा तो मार्क्स नहीं मिलेंगे।"
    ],
    "time_allocation": [
      {
        "section_id": "Q1_to_Q5_objective",
        "recommended_minutes": 0,
        "note": "30 मिनट — सब फॉर्मूला याद हों तो 28-30 मार्क्स पक्के।"
      },
      {
        "section_id": "Q6_to_Q17_very_short",
        "recommended_minutes": 0,
        "note": "40 मिनट — 3 मिनट पर क्वेश्चन। वर्किंग दिखाओ। OR ऑप्शन में ईज़ियर वाला चूज़ करो।"
      },
      {
        "section_id": "Q18_to_Q20_short",
        "recommended_minutes": 0,
        "note": "20 मिनट — 6-7 मिनट पर क्वेश्चन। प्रूफ याद करो (Q19)।"
      },
      {
        "section_id": "Q21_to_Q23_long",
        "recommended_minutes": 0,
        "note": "30 मिनट — 10 मिनट each। शब्द समस्या स्टेप-बाय-स्टेप, डायग्राम बनाओ (Q22), सारणी विधि (Q23)।"
      },
