    "important_formulas_quick_reference": {
      "Real_Numbers": [
        "HCF×LCM = a×b",
        "प्रूफ: मान लो √p = a/b, दोनों तरफ वर्ग करो, विरोधाभास"
      ],
      "Polynomials": [
        "α+β = -b/a",
        "αβ = c/a",
        "बहुपद = k[x²-(α+β)x+αβ]"
      ],
      "Linear_Equations": [
        "अद्वितीय: a1/a2≠b1/b2",
        "अनंत: a1/a2=b1/b2=c1/c2",
        "कोई हल नहीं: a1/a2=b1/b2≠c1/c2"
      ],
      "Quadratic_Equations": [
        "x=(-b±√(b²-4ac))/2a",
        "D=b²-4ac",
        "D>0: 2 वास्तविक, D=0: बराबर, D<0: कोई वास्तविक नहीं"
      ],
      "AP": [
        "aₙ=a+(n-1)d",
        "Sₙ=n/2[2a+(n-1)d]",
        "Sₙ=n/2(a+l)"
      ],
      "Coordinate_Geometry": [
        "d=√[(x₂-x₁)²+(y₂-y₁)²]",
        "मध्यबिंदु=((x₁+x₂)/2,(y₁+y₂)/2)"
      ],
      "Trigonometry": [
        "sin²A+cos²A=1",
        "1+tan²A=sec²A",
        "tanA=sinA/cosA"
      ],
      "Circles": [
        "स्पर्श रेखा⊥त्रिज्या स्पर्श बिंदु पर",
        "बाह्य बिंदु: PA=PB (बराबर स्पर्श रेखाएँ)"
      ],
      "Areas_Circles": [
        "त्रिज्यखंड का क्षेत्रफल=(θ/360)πr²",
        "चाप की लंबाई=(θ/360)×2πr"
      ],
      "Surface_Volumes": [
        "शंकु: V=(1/3)πr²h, l=√(r²+h²)",
        "गोलार्ध: V=(2/3)πr³, CSA=2πr², TSA=3πr²"
      ],
      "Statistics": [
        "माध्य=Σfx/Σf",
        "बहुलक=l+[(f₁-f₀)/(2f₁-f₀-f₂)]×h",
        "वर्ग चिह्न=(L+U)/2"
      ],
      "Probability": [
        "P(E)=अनुकूल/कुल",
        "P(E)+P(Ē)=1",
        "0≤P(E)≤1"
      ]
    },
