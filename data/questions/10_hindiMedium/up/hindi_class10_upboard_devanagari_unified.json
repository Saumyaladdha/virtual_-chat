      },
      "for_topping": {
        "strategy": "ऑल क्वेश्चन्स अटेम्प्ट विद फुल प्रिपरेशन। Q6 जीवन परिचय (10 मार्क्स) सही से लिखना टॉपर और एवरेज स्टूडेंट का सबसे बड़ा फर्क है।",
        "extra_focus_areas": [
          "Q6 — 5 लेखक + 5 कवि के जीवन परिचय पक्के याद करो (जन्म, रचनाएँ, भाषा शैली) — 10 मार्क्स",
          "Q10 निबंध — 250 शब्द, सुविचार + एग्ज़ांपल्स से समृद्ध — 6-7 मार्क्स",
          "Q1+Q2 — रेखांकित अंश की व्याख्या में भाव + अर्थ + भाषा शैली — 5-6 मार्क्स",
          "Q3+Q4 संस्कृत — शुद्ध अनुवाद + संदर्भ = 4-5 मार्क्स",
          "हैंडराइटिंग + प्रेज़ेंटेशन — सुंदर लेखन से मार्क्स मिलते हैं"
        ]
      }
    }
