# OpenAI
OPENAI_API_KEY=sk-...

# Google Gemini (for image generation)
GEMINI_API_KEY=AIza...

# AWS (DynamoDB — PYQ loader)
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=ap-south-1

# SSH Tunnel
SSH_HOST=<bastion-ip>
SSH_USER=ubuntu
SSH_KEY_PATH=/path/to/your/id_rsa

# RDS (MySQL via SSH tunnel)
RDS_HOST=<rds-endpoint>.rds.amazonaws.com
RDS_PORT=3306
DB_USER=<db-username>
DB_PASSWORD=<db-password>
DB_NAME=<database-name>
